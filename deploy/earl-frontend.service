[Unit]
Description=Earl Knows Ball Frontend (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rich
Group=rich
WorkingDirectory=/home/rich/earl-knows-football/frontend
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
